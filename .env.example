# GenLayer Deployment Configuration
# Copy this file to '.env' and fill in your values

# The treasury address to receive protocol fees (must be a valid GenLayer address format)
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Private key for the account deploying/interacting with the contract
# (GenLayer CLI reads this to sign deployment transactions)
PRIVATE_KEY=your_private_key_here
